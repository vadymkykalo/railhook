<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.webhook.platform</groupId>
        <artifactId>railhook</artifactId>
        <version>2.16.3</version>
    </parent>

    <artifactId>railhook-coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>Webhook Platform Coverage Report</name>
    <description>
        Not a real module - it ships no code of its own. It exists only
        so jacoco-maven-plugin's report-aggregate goal has a project whose
        *dependencies* are the four real modules, which is how JaCoCo
        discovers their target/classes and target/jacoco*.exec at reactor
        build time (report-aggregate walks the current project's dependency
        list, not the reactor's modules list - a plain multi-module pom
        parent is not enough on its own).

        Threshold enforcement (jacoco:check) deliberately does NOT live here:
        the check goal, unlike report-aggregate, only ever reads a single
        `dataFile` against ITS OWN project's compiled classes - it has no
        equivalent of report-aggregate's dependency-walking, so binding it in
        a pom-packaging module with no classes of its own just silently skips
        ("missing execution data file:.../railhook-coverage-report/target/jacoco.exec").
        Each of common/api/worker/cli therefore declares its own `check` execution
        against its own merged coverage instead - see the jacoco-merge
        execution in the root pom for how that per-module merged file gets
        built, and each module's own pom.xml for its threshold rules.

        Declared last in the root pom's modules list so the reactor builds
        it after common/api/worker/cli have already produced their classes
        and exec data (Maven also reorders by the dependency graph below
        regardless, so this is belt-and-braces).
    </description>

    <dependencies>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>railhook-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>railhook-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>railhook-worker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>railhook-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <!--
                      Bound to the `test` phase (not `verify`) so the task's
                      own verification command works verbatim:

                        mvn clean test jacoco:report

                      `report-aggregate` runs here as part of that same `test`
                      phase, once the four real modules ahead of it in the
                      reactor already have populated target/classes and
                      target/jacoco*.exec. dataFileIncludes' default of
                      **/jacoco*.exec is deliberately left unset (not
                      restricted to one exact file name): it is what lets this
                      goal fold together jacoco-unit.exec AND jacoco-it.exec
                      from a module's target dir when both are present (CI's
                      cross-job case, see coverage-report job in ci.yml), while
                      also happily aggregating a single default jacoco.exec
                      per module (the local, single-invocation case this
                      verbatim command exercises).

                      outputDirectory is pinned to <repo-root>/target instead
                      of this module's own target/, purely so
                      "target/site/jacoco-aggregate/index.html" resolves from
                      the repo root without an extra subdirectory hop.
                    -->
                    <execution>
                        <id>report-aggregate</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../target/site/jacoco-aggregate</outputDirectory>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
