{
  "name": "railhook/php",
  "description": "Official PHP SDK for Railhook — reliable webhook infrastructure",
  "type": "library",
  "license": "MIT",
  "version": "2.13.0",
  "keywords": [
    "webhook",
    "webhooks",
    "api",
    "events",
    "delivery"
  ],
  "authors": [
    {
      "name": "Vadym Kykalo",
      "email": "vadymkykalo@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Railhook\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railhook\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:contract": "phpunit -c phpunit.contract.xml",
    "analyse": "phpstan analyse src"
  },
  "config": {
    "sort-packages": true
  }
}
