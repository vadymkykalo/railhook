# === Java / Maven ===
target/
*.class
*.jar
*.war
*.ear
*.nar
*.log

# Maven wrapper (keep scripts, ignore binary jar if you want)
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar

# === IntelliJ IDEA ===
.idea/
*.iml
*.ipr
*.iws
out/

# === VS Code / Windsurf ===
.vscode/
.windsurf/
*.code-workspace

# === OS files ===
.DS_Store
Thumbs.db

# === Env / secrets ===
.env
.env.*
!.env.example
!.env.dist

# === Docker ===
**/docker-data/
**/data/
**/logs/
**/*.pid

# === Testcontainers ===
.testcontainers.properties

# === Gradle (just in case) ===
.gradle/
build/

# === Node (if UI appears later) ===
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# tsc --build caches, written next to whichever tsconfig was built. Per-machine
# and regenerated on every run; one of these got staged during a UI typecheck.
*.tsbuildinfo

# vitest --coverage output (webhook-platform-ui/coverage/, and any SDK's)
coverage/

# === Local override configs ===
application-local.yml
application-dev.yml
application-prod.yml

# === PHP SDK ===
sdks/php/vendor/
sdks/php/.phpunit.cache/
sdks/php/composer.lock

# === Python SDK ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
sdks/python/dist/
sdks/python/build/

# === Node SDK (dist already covered above) ===
sdks/node/dist/
sdks/node/coverage/

# === Backups ===
backups/

# === Helm ===
# Bitnami subchart deps fetched by `helm dependency build` — not vendored,
# CI (docker-publish.yml) fetches them fresh before packaging/linting.
deploy/helm/**/charts/
deploy/helm/**/Chart.lock
*.tgz

# === Agent task-board scratch space ===
# Working files for coordinating parallel coding-agent runs — not project
# documentation, not meant to be published in the repo.
.claude/features/

# === Agent TODO board ===
# Task breakdowns for work in flight — scratch, same lifetime as .claude/features/.
.claude/tasks/

# === Browser-automation scratch ===
# Screenshots and one-off scraper scripts an agent leaves behind while driving
# the UI. Never project documentation — real product screenshots belong in
# docs/screenshots/ and are referenced from the README or the docs site.
.playwright-mcp/

# === Stray captures at the repo root ===
# A screenshot dropped next to the pom is a scratch file, not an asset. The
# repo root is the first thing a visitor reads; keep it to files that earn
# their place. Assets live under docs/screenshots/ or
# webhook-platform-ui/public/.
/*.png
/*.jpg
/*.jpeg
/*.webp
webhook-platform-ui/*.png
