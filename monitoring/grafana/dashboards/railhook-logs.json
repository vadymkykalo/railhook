{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Trace by correlation ID / organization ID",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "railhook-loki" },
      "description": "Leave both variables blank to see everything from api+worker. Fill in a correlation ID to trace one request/delivery end to end across both services, or an organization ID to see everything for one tenant.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service=~\"api|worker\"} |= \"$correlation_id\" |= \"$organization_id\"",
          "refId": "A"
        }
      ],
      "title": "Logs — api + worker",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 101,
      "title": "Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "railhook-loki" },
      "description": "Log lines per minute by level, split by service. A spike in ERROR here without a matching Prometheus alert usually means the alert threshold hasn't caught up yet — this is the earlier signal.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (service, level) (count_over_time({service=~\"api|worker\"} | json [1m]))",
          "legendFormat": "{{service}} — {{level}}",
          "refId": "A"
        }
      ],
      "title": "Log volume by service + level",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "railhook-loki" },
      "description": "Count of ERROR-level lines, last 24h, per service — a quick eyeball total to accompany the volume-over-time panel on the left.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 25 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({service=~\"api|worker\"} | json | level=\"ERROR\" [24h]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "ERROR lines (24h)",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["railhook", "logs"],
  "templating": {
    "list": [
      {
        "name": "correlation_id",
        "type": "textbox",
        "label": "Correlation ID",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "organization_id",
        "type": "textbox",
        "label": "Organization ID",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Railhook — Logs",
  "uid": "railhook-logs",
  "version": 1
}
