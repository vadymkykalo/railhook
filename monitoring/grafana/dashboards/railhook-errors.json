{
  "uid": "railhook-errors",
  "title": "Errors",
  "description": "Error logs, HTTP 4xx/5xx inside the API and at nginx, auth failures, failed deliveries and the DLQ.",
  "tags": [
    "railhook",
    "errors"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "railhook"
      ],
      "targetBlank": false,
      "title": "Railhook",
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "railhook-loki"
        },
        "query": {
          "label": "service",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Errors in the logs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ERROR and WARN lines by service",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "railhook-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "railhook-loki"
          },
          "expr": "sum by (service, level) (count_over_time({service=~\"$service\"} | level=~\"error|warn\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{service}} {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error lines over the range",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "railhook-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "railhook-loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\"} | level=\"error\" [$__interval]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Most frequent error messages (api, worker)",
      "description": "Messages that embed an ID count separately; the Logs dashboard has the lines.",
      "datasource": {
        "type": "loki",
        "uid": "railhook-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "railhook-loki"
          },
          "expr": "topk(15, sum by (service, logger_name, message) (count_over_time({service=~\"api|worker\"} | level=\"error\" | json message=\"message\", logger_name=\"logger_name\" | __error__=\"\" [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Lines",
              "logger_name": "Logger"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Lines",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API responses, 4xx and 5xx",
      "description": "Measured inside the API (actuator).",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"railhook-api\", status=~\"[45]..\"}[$__rate_interval])) or label_replace(sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[$__rate_interval])) * 0, \"status\", \"none\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API 5xx ratio",
      "description": "ApiErrorRateHigh fires above 0.5% for 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"railhook-api\", status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[5m])) > 0) * 100 or sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[5m])) * 0",
          "refId": "A",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Auth failures and rate limiting (401, 403, 429)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{job=\"railhook-api\", status=~\"401|403|429\"}[$__rate_interval])) or label_replace(sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[$__rate_interval])) * 0, \"status\", \"none\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{status}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "nginx 4xx and 5xx (the entry point)",
      "description": "Includes the 502/504 of an API that was not there to answer.",
      "datasource": {
        "type": "loki",
        "uid": "railhook-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "railhook-loki"
          },
          "expr": "sum by (status) (count_over_time({service=\"ui\"} | pattern `<_> - <_> [<_>] \"<method> <uri> <_>\" <status> <_>` | status=~\"[45]..\" [$__interval])) or label_replace(sum(count_over_time({service=\"ui\"} [$__interval])) * 0, \"status\", \"none\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "nginx 5xx by path",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "railhook-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "railhook-loki"
          },
          "expr": "topk(10, sum by (status, uri) (count_over_time({service=\"ui\"} | pattern `<_> - <_> [<_>] \"<method> <uri> <_>\" <status> <_>` | status=~\"5..\" [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Responses",
              "uri": "Path"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Responses",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Deliveries",
      "collapsed": false,
      "panels": [],
