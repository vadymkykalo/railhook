        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outgoing delivery attempts by result",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "sum by (result) (rate(webhook_delivery_attempts_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Outgoing failure ratio",
      "description": "DlqRateHigh / IncomingForwardFailureRateHigh fire above 10%.",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "sum(rate(webhook_delivery_attempts_total{result=~\"failure|error\"}[15m])) / sum(rate(webhook_delivery_attempts_total[15m])) * 100",
          "refId": "A",
          "legendFormat": "failure %"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "sum(rate(incoming_forward_attempts_total{result=~\"failure|error\"}[15m])) / sum(rate(incoming_forward_attempts_total[15m])) * 100",
          "refId": "B",
          "legendFormat": "incoming forward failure %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
