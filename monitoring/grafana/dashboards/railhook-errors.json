    {
      "id": 15,
      "type": "timeseries",
      "title": "DLQ growth (1h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
