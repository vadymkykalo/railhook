    {
      "id": 7,
      "type": "table",
      "title": "Active alerts",
      "description": "Firing and pending, straight from Prometheus. Empty is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "ALERTS{alertname!=\"Watchdog\"}",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "component": 3
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "severity": "Severity",
              "component": "Component"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Severity"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "index": 0
                      },
                      "pending": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "options": {
        "mode": "markdown",
        "content": "**Silence, or see what is suppressed:** [Alert groups](/alerting/groups?alertmanager=Alertmanager) · [Silences](/alerting/silences?alertmanager=Alertmanager) · [Every rule](/alerting/list)\n\nRules live in `monitoring/prometheus/alerts.yml` (the platform) and `host-alerts.yml` (this host). Critical and warning alerts are mailed; the Watchdog goes only to the heartbeat URL."
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "History",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Firing over time",
      "datasource": {
        "type": "prometheus",
        "uid": "railhook-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "railhook-prometheus"
          },
          "expr": "max by (alertname, severity) (ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"})",
          "refId": "A",
          "legendFormat": "{{alertname}} ({{severity}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "firing",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Firing alerts by severity",
      "description": "",
      "datasource": {
        "type": "prometheus",
