    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 }, "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"railhook-api\", area=\"heap\"}", "legendFormat": "API {{id}}" },
        { "expr": "jvm_memory_committed_bytes{job=\"railhook-api\", area=\"heap\"}", "legendFormat": "API committed {{id}}" }
