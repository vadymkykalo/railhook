{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Platform Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] },
          "mappings": [{ "options": { "0": { "text": "UP" }, "1": { "text": "DOWN" } }, "type": "value" }]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"railhook-api\"}", "legendFormat": "API" }],
      "title": "API Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] },
          "mappings": [{ "options": { "0": { "text": "UP" }, "1": { "text": "DOWN" } }, "type": "value" }]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"railhook-worker\"}", "legendFormat": "Worker" }],
      "title": "Worker Status",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[5m]))", "legendFormat": "req/s" }],
      "title": "API Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.001 }, { "color": "red", "value": 0.01 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"railhook-api\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"railhook-api\"}[5m]))", "legendFormat": "5xx rate" }],
      "title": "API 5xx Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"railhook-api\"}[5m])) by (le))", "legendFormat": "p95" }],
      "title": "API Latency p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(event_ingest_total{job=\"railhook-api\"}[5m])) * 60", "legendFormat": "events/min" }],
      "title": "Events Ingested / min",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Delivery Pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "pointSize": 5 }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "delivery_queue_depth{status=\"pending\"}", "legendFormat": "Pending" },
        { "expr": "delivery_queue_depth{status=\"processing\"}", "legendFormat": "Processing" },
        { "expr": "delivery_queue_depth{status=\"dlq\"}", "legendFormat": "DLQ" }
      ],
      "title": "Delivery Queue Depth",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(webhook_delivery_attempts_total{result=\"success\"}[5m]))", "legendFormat": "Success" },
        { "expr": "sum(rate(webhook_delivery_attempts_total{result=\"failure\"}[5m]))", "legendFormat": "Failure" },
        { "expr": "sum(rate(webhook_delivery_attempts_total{result=\"error\"}[5m]))", "legendFormat": "Error" }
      ],
      "title": "Delivery Attempt Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "delivery_oldest_pending_age_seconds", "legendFormat": "Oldest Pending Age" }
      ],
      "title": "Oldest Pending Delivery Age",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(increase(delivery_attempts_cleanup_total[1h])) by (type)", "legendFormat": "{{type}}" }
      ],
      "title": "Cleanup Deleted (per hour)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Data Retention & Table Growth",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 20,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "delivery_attempts_table_rows", "legendFormat": "delivery_attempts" },
        { "expr": "incoming_events_table_rows", "legendFormat": "incoming_events" }
      ],
      "title": "Table Estimated Row Counts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000000 }, { "color": "red", "value": 10000000 }] } }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 23 },
      "id": 21,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "delivery_attempts_total", "legendFormat": "Total Attempts" }],
      "title": "Total Delivery Attempts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 23 },
      "id": 22,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "webhook_capture_slug_buckets_size", "legendFormat": "Slug Buckets" }],
      "title": "Rate Limiter Cache Size",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Billing Reconciliation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 32 },
      "id": 30,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "increase(billing_reconciliation_fixes_total[6h])", "legendFormat": "Fixes" },
        { "expr": "increase(billing_reconciliation_errors_total[6h])", "legendFormat": "Errors" }
      ],
      "title": "Billing Reconciliation (per 6h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "railhook-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 32 },
      "id": 31,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "increase(circuit_breaker_state_transitions_total[1h])", "legendFormat": "CB Trips" },
        { "expr": "increase(circuit_breaker_slow_trips_total[1h])", "legendFormat": "Slow Trips" },
        { "expr": "increase(circuit_breaker_rejected_total[1h])", "legendFormat": "Rejected" }
      ],
      "title": "Circuit Breaker Activity (per hour)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["railhook", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Railhook — Overview",
  "uid": "railhook-overview",
  "version": 1
}
