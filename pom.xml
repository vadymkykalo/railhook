<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.webhook.platform</groupId>
    <artifactId>railhook</artifactId>
    <version>2.13.0</version>
    <packaging>pom</packaging>

    <name>Webhook Platform</name>
    <description>Event Delivery Platform with Kafka and Spring Boot</description>

    <modules>
        <module>railhook-common</module>
        <module>railhook-api</module>
        <module>railhook-worker</module>
        <module>railhook-cli</module>
        <!--
          Must come after the four real modules above: it depends on all of
          them (compile scope) purely so JaCoCo's report-aggregate goal can
          discover their target/classes + jacoco*.exec at reactor build time.
          See railhook-coverage-report/pom.xml for why it exists.
        -->
        <module>railhook-coverage-report</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          4.x, because 3.5.16 was the final OSS release of the 3.5.x line and
          the fixes for the CVSS >= 9.0 CVEs in spring-core/spring-web 6.2.19
          and spring-security 6.5.11 ship only in Framework 7 / Security 7,
          which nothing below Boot 4 pins. Staying on 3.5.x meant carrying
          five unpatchable 9.8s past the point where a patch could ever land.

          Java stays on 17: Boot 4 still compiles to it, and moving both at
          once would have made it impossible to say which of the two broke
          anything.
        -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!--
          netty and lombok used to be pinned above what the Boot 3.5 BOM
          managed, because those pins carried CVEs the SCA gate failed on.
          Boot 4's BOM is ahead of both overrides (netty 4.2.17, lombok
          1.18.46), so re-declaring either here would now be a downgrade.
          The BOM manages them; leave them alone.

          Tomcat is the exception, and the reason this comment no longer says
          "all three". Boot 4.1.1's BOM manages 11.0.24, which carries three
          CRITICALs - CVE-2026-65182 (security-constraint bypass),
          CVE-2026-65905 (authentication bypass) and CVE-2026-68525 - all
          fixed in 11.0.25. Trivy gates on CRITICAL, so an unpinned build is
          a red build.

          This pin moves *forward* or disappears when the BOM passes it. It
          is never simply deleted: dropping it silently reintroduces three
          authentication and authorization bypasses in the container that
          terminates every request the API serves. Stay on the 11.x line -
          Boot 4 needs Jakarta EE 11.

          The property below is read by the dependencyManagement entries in
          this pom, NOT by Boot's BOM. Setting it alone changes nothing: this
          project *imports* spring-boot-dependencies rather than inheriting
          from spring-boot-starter-parent, and an imported BOM resolves its
          own `${tomcat.version}` against its own properties. That is why the
          three artifacts are pinned explicitly further down. Verify with
          `mvn dependency:tree -Dincludes=org.apache.tomcat.embed` - a version
          that still reads 11.0.24 there means the override is not taking.
        -->
        <tomcat.version>11.0.25</tomcat.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!--
          Single knob controlling where the JaCoCo agent writes exec
          data AND where the per-module `report` goal reads it back from, so
          the two stay in sync. CI overrides this on the command line
          (-Djacoco.destFile=target/jacoco-unit.exec vs
          target/jacoco-it.exec) because the unit and integration suites run
          as two separate `mvn test` invocations in two separate GitHub
          Actions jobs (see ci.yml) - distinct file names let both sets of
          exec data survive side by side once collected into one checkout,
          instead of one invocation silently clobbering the other's data (or,
          worse, a report step only ever seeing whichever job happened to run
          last). jacoco-maven-plugin's `destFile` parameter is already bound
          to this exact property name by default; it's declared here mainly
          to document it and to give `report`'s `dataFile` the same value.
        -->
        <jacoco.destFile>${project.build.directory}/jacoco.exec</jacoco.destFile>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Ahead of the BOM import on purpose: dependencyManagement takes
              the first declaration it finds, so these three win over the
              versions spring-boot-dependencies would otherwise supply. See
              the tomcat.version comment above for why the property by itself
              is not enough. All three artifacts move together - Tomcat does
              not support mixing versions across embed-core/websocket/el.
            -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
              Declared here (not just in pluginManagement) so the -parameters
              flag actually applies: pluginManagement only supplies config for
              plugins a module invokes explicitly, and none of common/api/worker
              declare their own compiler-plugin, so without this the default
              lifecycle-bound compile never received it. Confirmed missing via
              javap (no MethodParameters attribute), which broke unnamed
              @RequestParam bindings (e.g. AuditLogController) and named JPQL
              @Query parameters at runtime with IllegalArgumentException.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <!--
              Declared here (not just pluginManagement) for the same
              reason as maven-compiler-plugin above - so every child module
              gets it without having to declare it itself. Two executions:

              1. prepare-agent: attaches the JaCoCo javaagent to whatever
                 forked JVM surefire uses for `mvn test`, appending
                 (default `append=true`) to ${jacoco.destFile} rather than
                 overwriting it. That default append behavior is what makes
                 local verification work (`mvn clean test jacoco:report` runs
                 unit + integration classes together in one `test` phase, one
                 exec file) - it is NOT sufficient on its own for CI, where
                 the unit and integration suites are two separate `mvn test`
                 invocations on two separate runners with no shared
                 filesystem; see the CI job wiring in ci.yml and the
                 jacoco.destFile property comment above for how that gap is
                 closed (distinct file names + a downstream aggregate job).
              2. report: generates a per-module HTML/CSV/XML report right
                 after that module's own tests, from ${jacoco.destFile}. This
                 is NOT the cross-module number - see
                 railhook-coverage-report for the real aggregate.
                 It's just a quick per-module sanity report, and is skipped
                 (not failed) by JaCoCo when no exec data exists yet, which is
                 why it's harmless on modules like the coverage-report
                 aggregator itself that have no tests of their own.
              3. merge: folds every jacoco*.exec sitting in THIS module's own
                 target/ (jacoco.exec from a single local run, or
                 jacoco-unit.exec + jacoco-it.exec once CI's two test jobs'
                 artifacts have both been downloaded into it - see ci.yml)
                 into one target/jacoco-merged.exec. This exists because
                 jacoco:check (see the per-module `check` execution each of
                 common/api/worker/cli declares in its own pom.xml) - unlike
                 report-aggregate - only reads a single `dataFile` and has no
                 built-in way to combine several; merge is what makes that
                 single file the TRUE merged unit+integration coverage
                 instead of just whichever suite happened to run.
                 Deliberately does NOT include the exec file it itself
                 produces (jacoco-merged.exec) in its own inputs, so re-running
                 without a `clean` in between can't fold a merge into itself.
                 Bound to `verify` (after `check`'s own phase note below for
                 why), not `test`: see the check execution's comment in each
                 module's pom.xml for why that phase choice matters.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${jacoco.destFile}</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${jacoco.destFile}</dataFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-merge</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco.exec</include>
                                        <include>jacoco-unit.exec</include>
                                        <include>jacoco-it.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
