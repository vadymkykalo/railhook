<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.webhook.platform</groupId>
        <artifactId>railhook</artifactId>
        <version>2.16.4</version>
    </parent>

    <artifactId>railhook-api</artifactId>
    <name>Webhook Platform API</name>
    <description>REST API for event ingestion and management</description>

    <dependencies>
        <dependency>
            <groupId>com.webhook.platform</groupId>
            <artifactId>railhook-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
          The starter rather than bare spring-kafka: Boot 4 moved the Kafka
          auto-configuration out of spring-boot-autoconfigure into its own
          spring-boot-kafka module, which only the starter pulls in. Without it
          the spring.kafka.* block in application.yml would bind to nothing and
          the autoconfigure.exclude in the integration tests would name a class
          that is not on the classpath, which Boot treats as a startup failure.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          The starter, not bare flyway-core: Boot 4 no longer auto-configures a
          technology just because its library is on the classpath, and Flyway's
          auto-configuration moved into a module only this starter pulls in.
          With flyway-core alone the application starts, runs no migrations at
          all, and then fails Hibernate's schema validation on the first missing
          table - which is exactly how this was found.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!--
          Required as of Flyway 10 (bundled from Spring Boot 3.3+) -
          database support was split out of flyway-core into per-database
          modules. Without this, Flyway fails at startup with
          "Unsupported Database: PostgreSQL".
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 8.10.1 checked against Maven Central - already the latest
             release under the com.bucket4j coordinates; no bump needed. The
             project has since started publishing newer 8.x releases under
             io.github.bucket4j instead, which is a groupId/artifactId rename,
             not a compatibility requirement - left for a separate change. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <dependency>
            <groupId>com.jayway.jsonpath</groupId>
            <artifactId>json-path</artifactId>
            <version>2.9.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!--
          Bumped to 28.4.0, the last version before stripe-java 29.0.0
          (2025-04-01, Stripe API "basil" 2025-03-31) removed
          Subscription#getCurrentPeriodStart/End() and Invoice#getSubscription()
          / #getPaymentIntent() in favor of SubscriptionItem-level periods and
          Invoice#getParent()/getPayments(). StripeBillingProvider uses all
          four. stripe-java is a plain HTTP client with no Spring/Java
          framework coupling, so nothing here is required for Spring Boot
          3.5/Java compatibility - going all the way to current (33.x) would
          mean rewriting the subscription/invoice period and payment-intent
          logic against Stripe's new object model, which needs its own
          reviewed change (and ideally a real Stripe sandbox to verify
          against), not a silent side effect of a framework upgrade.
        -->
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>28.4.0</version>
        </dependency>
        <!--
          springdoc 3.x is the Boot 4 line; the 2.x we were on builds against
          Framework 6 and Boot 3's module layout. Not a routine version bump:
          the whole of openapi.yaml, and everything generated from it, is this
          library's output, so OpenApiDriftIntegrationTest is the check that
          the upgrade did not quietly reshape the published contract.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          4.x is the Boot 4 line: its starter builds against spring-boot 4.1 and registers
          the auto-configuration Boot 4 looks for, where 3.52.0 wires itself against Boot 3's
          module layout. It also renamed RScript.ReturnType's constants to match the Java
          types they return - INTEGER to LONG, MULTI to LIST - which is what the circuit
          breaker's and the ordering buffer's Lua scripts ask for.

          Verify this one against a running stack, not the test suite: the integration tests
          exclude RedissonAutoConfigurationV2 outright and mock every service that reaches for
          Redis, so a Redisson that fails to wire would leave them all green.
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>4.7.0</version>
        </dependency>
        <!--
          webclient, not webflux. Boot 4 split WebClient's auto-configuration out of the
          WebFlux starter, which is now only the reactive *server* stack - and this service
          serves over Tomcat via spring-boot-starter-web. WebClient is all it ever wanted
          from webflux; without this starter there is no WebClient.Builder bean and every
          outbound call (alert notifications, billing providers, Slack nodes) fails to wire.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webclient</artifactId>
        </dependency>
        <!--
          What keeps HTTP on Jackson 2, which Boot 4 otherwise replaces with Jackson 3.
          Deprecated by Spring, and taken anyway: two DTOs put a Jackson 2 JsonNode on the wire
          (EventIngestRequest.data, PlanResponse.features), and the second is a JSONB column on
          the Plan entity that the schema-validation gate also reads. Moving to Jackson 3 means
          changing an entity's persisted type and its copy in the worker, which is a data-layer
          change with a migration behind it - not a side effect of an upgrade whose whole
          purpose is closing five CVSS 9.8s.

          This module and spring.http.converters.preferred-json-mapper in application.yml are
          both required, and they fail differently: without the module nothing wires at all,
          while without the property reading a body into a JsonNode field answers 500 and
          writing one still works. JsonSerializationContractIntegrationTest covers both
          directions for exactly that reason.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!--
          Bumped within the 5.x line only (latest is 5.16.0). ShedLock
          6.0.0 (2025) restructured lock-provider internals - e.g. multiple
          LockProvider support - and 7.0.0-RC1 moved DatabaseProduct to a new
          package and tightened SQL-provider error handling; neither release's
          notes confirm the net.javacrumbs.shedlock.core.{LockProvider,
          DefaultLockingTaskExecutor,LockingTaskExecutor} imports ShedLockConfig
          relies on are unaffected. Staying on the latest 5.x avoids betting
          that on an unverified assumption; revisit 6.x/7.x as its own
          reviewed change.
        -->
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-spring</artifactId>
            <version>5.16.0</version>
        </dependency>
        <dependency>
            <groupId>net.javacrumbs.shedlock</groupId>
            <artifactId>shedlock-provider-jdbc-template</artifactId>
            <version>7.10.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 split spring-boot-test-autoconfigure apart: @AutoConfigureMockMvc,
          @DataJpaTest, TestEntityManager and @AutoConfigureTestDatabase each moved into a
          module of their own, and spring-boot-starter-test no longer carries any of them.
          These four starters are that one dependency, unbundled.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 1.21.4 is already the latest 1.x release (matches Spring
             Boot 3.5's own managed Testcontainers baseline of 1.21.x).
             Testcontainers 2.0.0 is a new major line published in 2026 -
             out of scope here; left for a separate, dedicated change. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <!--
                  2.22.2 predates JUnit 5.9+'s OutputDirectoryProvider
                  API. With Spring Boot 3.5.16's newer managed JUnit Jupiter
                  version, that old surefire silently discovered zero tests
                  ("unaligned versions of the junit-platform-engine and
                  junit-platform-launcher jars") instead of failing loudly.
                -->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <!--
              See the matching comment in railhook-common's
              pom.xml for the shared rationale (merged exec file, `verify`
              phase choice). Two rules here, not one:

              1. BUNDLE - project floor for this module. Re-measured
                 2026-08-22 (unit + integration merged, 749 tests across 72
                 classes): INSTRUCTION 40.2% (43576/108405), up from 33.1%
                 at the 2026-08-21 baseline. Still by far the biggest module
                 (602 classes), which is why its bundle percentage sits below
                 worker's even though plenty of individual classes are well
                 covered. Floor set a few points under the measured value: a
                 gate pinned exactly at the current number goes red on
                 ordinary measurement jitter.
              2. CLASS - floors on the two api-side halves of the
                 ordering/delivery path (the rest - WebhookDeliveryService,
                 AttemptRunner, RetrySchedulerService, OrderingBufferService,
                 DeliveryConsumer - lives in railhook-worker and has
                 its own CLASS rule there).

                 OutboxPublisherService: measured 74.7% on 2026-08-22, up
                 from 56.5%.

                 SequenceGeneratorService: measured 77.8%, up from 6.8%.
                 It used to be excluded from this rule on purpose, with the
                 note that a floor near its then-actual value would
                 rubber-stamp the gap instead of flagging it, and that it
                 should be added "once the class is actually tested". It now
                 is, so it is in.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.37</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.webhook.platform.api.service.OutboxPublisherService</include>
                                        <include>com.webhook.platform.api.service.SequenceGeneratorService</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
