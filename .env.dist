# ============================================================================
# Railhook - Environment Configuration Reference
# ============================================================================
# Every setting, not an install template — its secrets are public. Install with
# `curl -fsSL https://railhook.io/install.sh | bash`, which generates them.

# ----------------------------------------------------------------------------
# DEPLOYMENT MODE (REQUIRED)
# ----------------------------------------------------------------------------
# Where PostgreSQL runs: embedded (in Docker) | external (managed database).
DB_MODE=embedded

# Compose project name. Pinned because the monitoring stack joins this project's network by
# name, and Compose would otherwise derive it from the clone's directory name.
COMPOSE_PROJECT_NAME=railhook

# Registry prefix for the api, worker and ui images; defaults to ghcr.io/vadymkykalo/railhook.
# DOCKER_REGISTRY=ghcr.io/yourorg/railhook

# ----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ----------------------------------------------------------------------------
# development | staging | production. Production refuses to start with placeholder secrets.
APP_ENV=development

# Public origin of the dashboard, used in emails, shared links, canonical tags and the sitemap.
# Include the port when it is not 80, e.g. http://localhost:8080.
APP_BASE_URL=http://localhost

# ----------------------------------------------------------------------------
# DATABASE - EMBEDDED MODE (when DB_MODE=embedded)
# ----------------------------------------------------------------------------
# Image and credentials of the PostgreSQL container.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=webhook_platform
POSTGRES_USER=webhook_user
POSTGRES_PASSWORD=webhook_dev_pass_12345

# ----------------------------------------------------------------------------
# DATABASE - EXTERNAL MODE (when DB_MODE=external)
# ----------------------------------------------------------------------------
# Database connection; DB_HOST stays `postgres` (the Compose service) in embedded mode.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=webhook_platform
DB_USER=webhook_user
DB_PASSWORD=webhook_dev_pass_12345
# disable | require | verify-full
DB_SSL_MODE=disable

# Full JDBC URL; when set, DB_HOST, DB_PORT and DB_NAME are ignored.
DB_JDBC_URL=

# API connection pool (connections; timeout in ms). Named apart from the worker's on purpose:
# a shared name once gave the worker the API's smaller pool.
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=10
DB_POOL_CONNECTION_TIMEOUT=30000

# Worker connection pool. Smaller than the worker's thread count because no transaction spans
# the outbound HTTP call; check hikari_connections_pending under load before changing it.
WORKER_DB_POOL_MAX_SIZE=40
WORKER_DB_POOL_MIN_IDLE=20

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION (for distributed rate limiting & concurrency)
# ----------------------------------------------------------------------------
# Redis image, address, password and memory cap.
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=webhook_redis_pass
REDIS_MAXMEMORY=256mb

# ----------------------------------------------------------------------------
# KAFKA CONFIGURATION
# ----------------------------------------------------------------------------
# Kafka bootstrap servers: kafka:9092 in embedded mode, your cluster otherwise.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_IMAGE=apache/kafka:3.7.0
# Partitions per topic; the ceiling on consumer parallelism.
KAFKA_NUM_PARTITIONS=12

# Consumer group IDs; prefix them with the environment on a shared cluster.
KAFKA_CONSUMER_GROUP_ID=webhook-worker
KAFKA_INCOMING_GROUP_ID=incoming-forward-worker

# Outgoing delivery consumer threads; keep at or below KAFKA_NUM_PARTITIONS.
KAFKA_DELIVERY_CONCURRENCY=6
# Incoming forward consumer threads; keep at or below KAFKA_NUM_PARTITIONS.
KAFKA_INCOMING_CONCURRENCY=3

# How long one producer send may keep retrying (ms); an expired send is retried from the outbox.
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000
# How long send() may block on cluster metadata (ms). Kafka's 60s default would hold the
# shared scheduler threads the outbox publisher runs on.
KAFKA_PRODUCER_MAX_BLOCK_MS=10000

# Worker consumer offset reset policy and retries on a failed record (interval in ms).
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_INTERVAL_MS=5000

# ----------------------------------------------------------------------------
# SECURITY (REQUIRED - MUST CHANGE FOR PRODUCTION)
# ----------------------------------------------------------------------------
# Key that encrypts stored secrets, 32+ characters. Change it in production.
WEBHOOK_ENCRYPTION_KEY=dev_encryption_key_32_chars_min!

# PBKDF2 salt for the AES-256 key, 16+ characters, unique per deployment. Change it in production.
WEBHOOK_ENCRYPTION_SALT=dev_encryption_salt_16_chars

# Keys for zero-downtime rotation as "version:key,version:key"; empty uses WEBHOOK_ENCRYPTION_KEY as version 1.
WEBHOOK_ENCRYPTION_KEYS=
# Key version new encryptions use; 0 picks the highest.
WEBHOOK_ENCRYPTION_KEY_ACTIVE_VERSION=0

# JWT signing secret, 32+ characters. Change it in production.
JWT_SECRET=dev_jwt_secret_key_32_chars_minimum

# Token for /api/v1/admin/** (X-Platform-Admin-Token header), including key rotation across all
# organizations; an organization OWNER does not get this. Empty keeps those endpoints closed.
PLATFORM_ADMIN_TOKEN=

# Comma-separated emails allowed into the platform admin panel (sign-in under 12 hours old).
# Empty means nobody.
PLATFORM_ADMIN_EMAILS=

# ----------------------------------------------------------------------------
# API SERVICE
# ----------------------------------------------------------------------------
# API image tag.
API_IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# WORKER SERVICE
# ----------------------------------------------------------------------------
# Worker image tag.
WORKER_IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# SCHEDULING (api + worker)
# ----------------------------------------------------------------------------
# Threads shared by all scheduled jobs. Keep at 8 or more: with Spring's default of 1, one slow
# job stalls every other one, outbox dispatch included.
SCHEDULING_POOL_SIZE=8

# ----------------------------------------------------------------------------
# UI SERVICE
# ----------------------------------------------------------------------------
# Host port and bind address of the dashboard's nginx, the only published port; it also proxies
# the API. Use RAILHOOK_BIND=127.0.0.1 behind a reverse proxy.
RAILHOOK_PORT=8080
RAILHOOK_BIND=0.0.0.0

# Domain and ACME contact for the built-in Caddy TLS terminator (COMPOSE_PROFILES=tls).
RAILHOOK_DOMAIN=
ACME_EMAIL=

# UI image tag.
UI_IMAGE_TAG=latest
# Build-time only: API origin baked into the UI bundle. Leave empty; the UI's nginx proxies the
# API on the same origin. If set, add it to CORS_ALLOWED_ORIGINS too.
VITE_API_URL=
# Build-time only: extra CSP connect-src origins, space-separated.
VITE_CSP_EXTRA_CONNECT=

# Domain for the sales@ and support@ addresses on /contact and in the footer, e.g. example.com.
# Empty offers no addresses. Read by the ui container at start.
RAILHOOK_CONTACT_DOMAIN=

# ----------------------------------------------------------------------------
# OUTBOX PUBLISHER
# ----------------------------------------------------------------------------
# Poll interval for pending outbox messages (ms).
OUTBOX_POLL_INTERVAL_MS=1000
# Retry interval for failed outbox messages (ms).
OUTBOX_RETRY_INTERVAL_MS=30000
# Cleanup interval for PUBLISHED and DEAD outbox messages (ms).
OUTBOX_CLEANUP_INTERVAL_MS=3600000
# Messages per poll.
OUTBOX_BATCH_SIZE=100
# Publish retries before a message goes DEAD.
OUTBOX_MAX_RETRIES=5
# Days DEAD messages are kept for manual re-drive.
OUTBOX_DEAD_RETENTION_DAYS=90
# Seconds before a stuck SENDING message returns to PENDING; must exceed KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS.
OUTBOX_SENDING_RECOVERY_SECONDS=300
# Seconds to wait for a batch of Kafka sends to complete.
OUTBOX_BATCH_SEND_TIMEOUT_SECONDS=30
# Messages claimed per project per batch, so one project cannot crowd out the rest.
OUTBOX_MAX_PER_PROJECT=30

# Messages claimed per endpoint per batch. With a 1000 ms poll this caps one endpoint at 10
# events/s whatever OUTBOX_BATCH_SIZE is; raise it only when one endpoint dominates.
OUTBOX_MAX_PER_KEY=10

# DATA RETENTION POLICIES
# ----------------------------------------------------------------------------
# Days to keep failed and successful (2xx) Attempts, and received incoming events.
DATA_RETENTION_ATTEMPTS_DAYS=90
DATA_RETENTION_SUCCESSFUL_ATTEMPTS_DAYS=14
DATA_RETENTION_INCOMING_EVENTS_DAYS=30

# Days to keep Events and, by cascade, their Deliveries; -1 keeps them forever. The only bound
# on those tables when billing is off. Matches DATA_RETENTION_ATTEMPTS_DAYS on purpose.
DATA_RETENTION_EVENTS_DAYS=90

# Most recent Attempts kept per Delivery.
DATA_RETENTION_MAX_ATTEMPTS_PER_DELIVERY=10

# Rows per cleanup batch.
DATA_RETENTION_BATCH_SIZE=1000

# Cleanup schedule (cron, daily at 2 AM).
DATA_RETENTION_CRON=0 0 2 * * *

# Limit enforcement schedule (cron, every 30 minutes).
DATA_RETENTION_LIMIT_CRON=0 */30 * * * *

# Extra cleanup for daytime error spikes (cron, every 4 hours).
DATA_RETENTION_BURST_CLEANUP_CRON=0 0 */4 * * *

# Table size gauge refresh interval (ms).
DATA_RETENTION_TABLE_METRICS_INTERVAL_MS=900000

# PARTITION MAINTENANCE
# ----------------------------------------------------------------------------
# Creates delivery_attempts and tunnel_request_log partitions ahead of need and drops those past
# retention; lookahead in months and weeks, schedule as cron.
PARTITION_MAINTENANCE_ENABLED=true
PARTITION_MAINTENANCE_DELIVERY_ATTEMPTS_LOOKAHEAD_MONTHS=3
PARTITION_MAINTENANCE_TUNNEL_LOG_LOOKAHEAD_WEEKS=3
PARTITION_MAINTENANCE_CRON=0 45 1 * * *

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Platform-wide request limit per instance (requests/s).
GLOBAL_RATE_LIMIT_PER_SECOND=5000

# Per-organization request limit (requests/s), for shared installs where one tenant must not spend
# everyone's budget. Costs a Redis round trip per request, so leave it off when self-hosting.
ORG_RATE_LIMIT_ENABLED=false
ORG_RATE_LIMIT_PER_SECOND=200
GLOBAL_RATE_LIMIT_ENABLED=true

# Events per second per project (token bucket).
EVENT_INGESTION_RATE_LIMIT_PER_SECOND=100

# Sign-in and registration attempts per minute, per IP and per email.
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=10
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5
# Session refreshes per minute, per refresh token and per IP. Separate from sign-in, whose budget
# page loads would otherwise exhaust.
AUTH_RATE_LIMIT_REFRESH_PER_TOKEN_PER_MINUTE=30
AUTH_RATE_LIMIT_REFRESH_PER_IP_PER_MINUTE=600

# ----------------------------------------------------------------------------
# PASSWORD AUTHENTICATION
# ----------------------------------------------------------------------------
# BCrypt cost, 4-31; each step doubles the work. Changing it never invalidates stored hashes.
AUTH_BCRYPT_STRENGTH=12

# Lock an account after consecutive failed sign-ins. Held in Postgres, not Redis, so it does not
# weaken when Redis is down. Locks expire on their own and a password reset clears them.
AUTH_LOCKOUT_ENABLED=true
# Consecutive failures before the account locks.
AUTH_LOCKOUT_THRESHOLD=5
# First lockout, in seconds. Doubles with each further failure.
AUTH_LOCKOUT_INITIAL_SECONDS=60
# Cap on the doubling, in seconds; longer only helps someone locking a stranger out.
AUTH_LOCKOUT_MAX_SECONDS=900
# Minutes after which a failure no longer counts toward the lockout.
AUTH_LOCKOUT_FAILURE_WINDOW_MINUTES=60

# Interval for purging expired sessions (ms).
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000

# ----------------------------------------------------------------------------
# WEBHOOK DELIVERY
# ----------------------------------------------------------------------------
# Largest event payload accepted (bytes).
WEBHOOK_MAX_PAYLOAD_SIZE_BYTES=262144

# Most Deliveries one Event may fan out to.
WEBHOOK_MAX_FANOUT_PER_EVENT=100

# Payloads larger than this are stored gzip-compressed (bytes).
WEBHOOK_PAYLOAD_COMPRESSION_THRESHOLD_BYTES=1024

# Seconds an organization's suspension state is cached on each node; other nodes see a change
# within this window.
ORGANIZATION_SUSPENSION_CACHE_TTL_SECONDS=60

# Deliveries per second one project may take from the shared worker pool. Not the plan's ingest
# limit: size it from WEBHOOK_OUTGOING_POOL_SIZE.
WEBHOOK_PROJECT_RATE_LIMIT_PER_SECOND=50

# Require new endpoints to prove ownership before they receive deliveries (true | false).
WEBHOOK_ENDPOINT_VERIFICATION_REQUIRED=false

# Minutes a received signature is remembered to reject replays. For a source signed with a plain
# body HMAC this is the only replay bound; raise it for such sources.
WEBHOOK_INGRESS_REPLAY_WINDOW_MINUTES=5

# Allow delivery to private IPs (SSRF risk, e.g. cloud metadata). Development only; refused in production.
WEBHOOK_ALLOW_PRIVATE_IPS=false

# Concurrent deliveries per endpoint.
WEBHOOK_MAX_CONCURRENT_PER_ENDPOINT=5

# Concurrent in-flight attempts per organization across all its endpoints, so one tenant's slow
# receivers cannot occupy the whole WEBHOOK_OUTGOING_POOL_SIZE.
WEBHOOK_MAX_CONCURRENT_PER_TENANT=20

# Seconds a concurrency permit lives before Redis reclaims it; must exceed the 60s maximum
# delivery timeout plus setup time.
WEBHOOK_CONCURRENCY_PERMIT_LEASE_SECONDS=90

# Threads for outgoing deliveries.
WEBHOOK_OUTGOING_POOL_SIZE=50

# Threads for incoming forwards.
WEBHOOK_INCOMING_POOL_SIZE=20

# Seconds to wait for in-flight deliveries on shutdown.
WEBHOOK_ASYNC_SHUTDOWN_TIMEOUT_SECONDS=60

# ─── Dashboard error reporting ───────────────────────────────────────────────────────────
# Dashboard errors are posted back and written to this installation's own logs, never to a
# third party; reports per user per minute.
CLIENT_ERROR_REPORTING_ENABLED=true
CLIENT_ERROR_REPORTS_PER_USER_PER_MINUTE=20

# Receiver response body buffered per attempt (bytes); past it the status code alone decides.
# Only the first 10 KiB is stored.
WEBHOOK_MAX_RESPONSE_BODY_BYTES=1048576

# ─── JavaScript transformations ────────────────────────────────────────────────────────────
# Wall-clock limit per script run (ms); a runaway script holds one delivery slot this long. Exceeding
# any of these limits fails the Delivery, which is retried.
TRANSFORM_SCRIPT_TIMEOUT_MS=2000

# Allocation limit per run (MB), counted as total allocation rather than live heap.
TRANSFORM_SCRIPT_MAX_MEMORY_MB=128

# Largest body a script may return (bytes).
TRANSFORM_SCRIPT_MAX_OUTPUT_BYTES=1048576

# console.* lines kept per run for the Transform Studio.
TRANSFORM_SCRIPT_MAX_CONSOLE_LINES=100

# Largest script the engine compiles (characters).
TRANSFORM_SCRIPT_MAX_CHARS=65536

# Outgoing HTTP connection pool shared by deliveries and forwards (connections, seconds).
WEBHOOK_POOL_MAX_CONNECTIONS=200
WEBHOOK_POOL_PENDING_ACQUIRE_TIMEOUT_SECONDS=10
WEBHOOK_POOL_MAX_IDLE_TIME_SECONDS=60

# Comma-separated host names exempt from the private-IP check, matched as written in the endpoint
# URL. Empty exempts nothing; other rules still apply.
WEBHOOK_ALLOWED_HOSTS=

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For sets the client IP (rate limits, audit,
# source IP checks); behind a CDN include its ranges. Empty trusts nothing.
WEBHOOK_TRUSTED_PROXIES=

# ----------------------------------------------------------------------------
# INCOMING WEBHOOKS
# ----------------------------------------------------------------------------
# Base URL for ingress URLs shown in the dashboard.
WEBHOOK_INGRESS_BASE_URL=http://localhost:8080

# Largest incoming payload accepted (bytes).
WEBHOOK_INCOMING_MAX_PAYLOAD_SIZE_BYTES=524288

# Default ingress limit for a source that sets none (requests/s); 0 disables the default.
WEBHOOK_INCOMING_RATE_LIMIT_PER_SECOND=100

# Incoming forward retry scheduler: poll interval (ms), batch size, and per-destination cap.
INCOMING_FORWARD_RETRY_POLL_INTERVAL_MS=10000
INCOMING_FORWARD_RETRY_BATCH_SIZE=50
INCOMING_FORWARD_RETRY_MAX_PER_DEST=10

# Pending forward retries above which the governor shrinks batches.
INCOMING_FORWARD_RETRY_HIGH_WATERMARK=3000

# DLQ monitoring interval (ms).
DLQ_MONITORING_INTERVAL_MS=60000
# Timeout for DLQ monitoring's Kafka admin calls (seconds).
DLQ_MONITORING_ADMIN_CLIENT_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------------
# ORDERING (FIFO delivery per endpoint)
# ----------------------------------------------------------------------------
# Seconds an ordered Delivery waits on a gap before going out of order, and only once nothing in
# the gap is being or about to be attempted.
ORDERING_GAP_TIMEOUT_SECONDS=60

# Fallback poll for a Delivery parked behind a missing sequence (seconds).
ORDERING_BUFFER_RESCHEDULE_DELAY_SECONDS=5

# TTL of delivered-sequence tracking in Redis (hours).
ORDERING_DELIVERED_SEQ_TTL_HOURS=24

# TTL of the ordering buffer in Redis (minutes).
ORDERING_BUFFER_TTL_MINUTES=10

# How often the ordering buffer size gauge resyncs from Redis (ms).
ORDERING_BUFFER_GAUGE_RESYNC_MS=30000

# Backfills ordered Deliveries left without a sequence number by a process that died after
# commit; only rows older than this many seconds, per batch. Below a few seconds it races ingest.
ORDERING_STRANDED_SEQUENCE_AFTER_SECONDS=120
ORDERING_STRANDED_SEQUENCE_BATCH_SIZE=500

# How far back sequence reconciliation looks for active ordered endpoints (hours).
ORDERING_SEQUENCE_RECONCILIATION_LOOKBACK_HOURS=48

# Sequence reconciliation interval (ms).
ORDERING_SEQUENCE_RECONCILIATION_INTERVAL_MS=900000

# ----------------------------------------------------------------------------
# EVENT TIME MACHINE (REPLAY)
# ----------------------------------------------------------------------------
# Events read per replay batch.
REPLAY_BATCH_SIZE=200

# Pause between replay batches (ms).
REPLAY_BATCH_DELAY_MS=50

# Most events one replay session may cover.
REPLAY_MAX_EVENTS_PER_SESSION=500000

# ----------------------------------------------------------------------------
# RETRY SCHEDULER
# ----------------------------------------------------------------------------
# Largest retry batch; the governor adapts below it.
RETRY_SCHEDULER_BATCH_SIZE=100

# Retries claimed per endpoint per poll.
RETRY_SCHEDULER_MAX_PER_ENDPOINT=10

# Retries claimed per project per poll.
RETRY_SCHEDULER_MAX_PER_PROJECT=30

# Pending retries above which the governor shrinks batches, avoiding a retry storm after an outage.
RETRY_SCHEDULER_HIGH_WATERMARK=5000

# Seconds to wait for a Kafka send to be confirmed.
RETRY_SCHEDULER_SEND_TIMEOUT_SECONDS=30

# Seconds before a failed send is rescheduled.
RETRY_SCHEDULER_RESCHEDULE_DELAY_SECONDS=60

# Baseline poll interval (ms); the governor polls 3x slower when idle and up to 5x faster under backlog.
RETRY_SCHEDULER_POLL_INTERVAL_MS=10000

# Longest a receiver's Retry-After (on 429 and 503) may delay the next attempt (seconds); it only
# ever delays. 0 ignores the header. Kept within DELIVERY_ESCALATION_HARD_CAP_HOURS.
WEBHOOK_RETRY_AFTER_MAX_SECONDS=21600

# ----------------------------------------------------------------------------
# STUCK DELIVERY RECOVERY
# ----------------------------------------------------------------------------
# Minutes after which a Delivery stuck in PROCESSING is reset.
STUCK_DELIVERY_THRESHOLD_MINUTES=5

# Minutes after which an unclaimed PENDING Delivery with no retry time is reset; keep well above
# the normal dispatch time.
STUCK_DELIVERY_STRANDED_PENDING_THRESHOLD_MINUTES=60

# Check interval (ms).
STUCK_DELIVERY_CHECK_INTERVAL_MS=60000

# ----------------------------------------------------------------------------
# STUCK FORWARD RECOVERY (incoming forward attempts)
# ----------------------------------------------------------------------------
# Minutes after which a Forward stuck in PROCESSING is reset.
STUCK_FORWARD_THRESHOLD_MINUTES=5

# Minutes after which a PENDING Forward with no retry time goes back to the retry scheduler; keep
# well above the normal dispatch time.
STUCK_FORWARD_STRANDED_PENDING_THRESHOLD_MINUTES=60

# Check interval (ms).
STUCK_FORWARD_CHECK_INTERVAL_MS=60000

# ----------------------------------------------------------------------------
# AUTO-DISABLE A PERSISTENTLY FAILING TARGET
# ----------------------------------------------------------------------------
# Turn off an endpoint or destination that has only failed for a whole window, and notify its
# owners. Set it the same on api and worker.
ENDPOINT_AUTO_DISABLE_ENABLED=true

# Hours of failures without a success before disabling, at least 1. Shorter than
# DELIVERY_ESCALATION_HARD_CAP_HOURS on purpose.
ENDPOINT_AUTO_DISABLE_AFTER_HOURS=72

# Failed attempts that window must also contain, so an idle endpoint is not disabled.
ENDPOINT_AUTO_DISABLE_MIN_FAILURES=10

# Sweep interval (ms) and targets checked per sweep.
ENDPOINT_AUTO_DISABLE_INTERVAL_MS=300000
ENDPOINT_AUTO_DISABLE_BATCH_SIZE=200

# ----------------------------------------------------------------------------
# CIRCUIT BREAKER (Redis-backed, shared across worker pods)
# ----------------------------------------------------------------------------
# Failure rate that opens the circuit (percent, 0-100).
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50

# Calls needed before the failure rate is evaluated.
CIRCUIT_BREAKER_MINIMUM_CALLS=5

# Seconds the circuit stays open before probing.
CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=30

# Sliding window of the failure counters (seconds).
CIRCUIT_BREAKER_WINDOW_TTL_SECONDS=120

# A call slower than this counts as slow, even with a 2xx (ms).
CIRCUIT_BREAKER_SLOW_CALL_THRESHOLD_MS=10000

# Slow call rate that opens the circuit (percent, 0-100).
CIRCUIT_BREAKER_SLOW_CALL_RATE_THRESHOLD=80

# ----------------------------------------------------------------------------
# STALE DELIVERY ESCALATION (hard-cap auto-DLQ)
# ----------------------------------------------------------------------------
# Hours after which a PENDING Delivery goes to the DLQ. Must cover the outgoing retry ladder's
# worst case (~83h), or startup fails.
DELIVERY_ESCALATION_HARD_CAP_HOURS=96

# Deliveries per escalation batch.
DELIVERY_ESCALATION_BATCH_SIZE=100

# ----------------------------------------------------------------------------
# STALE FORWARD ESCALATION (hard-cap auto-DLQ, Incoming)
# ----------------------------------------------------------------------------
# Hours from receipt after which an outstanding Forward goes to the DLQ; batch size and interval (ms).
# Must cover the incoming retry ladder's worst case (~11h), or startup fails.
FORWARD_ESCALATION_HARD_CAP_HOURS=24
FORWARD_ESCALATION_BATCH_SIZE=100
FORWARD_ESCALATION_INTERVAL_MS=300000

# Stale delivery check interval (ms).
DELIVERY_ESCALATION_INTERVAL_MS=300000

# ----------------------------------------------------------------------------
# QUEUE DEPTH METRICS
# ----------------------------------------------------------------------------
# Queue depth gauge refresh interval (ms).
QUEUE_DEPTH_METRICS_INTERVAL_MS=900000

# Only rows created within this many days are counted.
QUEUE_DEPTH_METRICS_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# TEST ENDPOINTS (Request Bin)
# ----------------------------------------------------------------------------
# Public origin of test endpoint URLs (…/hook/<slug>); defaults to APP_BASE_URL. Never an internal name.
# TEST_ENDPOINT_BASE_URL=

# Test endpoints per project.
TEST_ENDPOINT_MAX_PER_PROJECT=10

# Longest test endpoint lifetime (hours).
TEST_ENDPOINT_MAX_TTL_HOURS=72

# Expired test endpoint cleanup interval (ms).
TEST_ENDPOINT_CLEANUP_INTERVAL_MS=3600000

# ----------------------------------------------------------------------------
# RULES ENGINE
# ----------------------------------------------------------------------------
# Compiled rules cache refresh (ms).
RULES_CACHE_REFRESH_MS=30000

# Rule execution log retention (days).
RULES_EXECUTION_LOG_RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# TRANSFORMATIONS
# ----------------------------------------------------------------------------
# Published versions kept per transformation (up to ~64 KB each); the one in use is never dropped.
TRANSFORMATION_HISTORY_LIMIT=50

# ----------------------------------------------------------------------------
# WORKFLOW ENGINE
# ----------------------------------------------------------------------------
# Workflow executor threads and queue capacity.
WORKFLOW_POOL_CORE_SIZE=4
WORKFLOW_POOL_MAX_SIZE=8
WORKFLOW_POOL_QUEUE_CAPACITY=50

# Longest a workflow run may take (seconds).
WORKFLOW_MAX_DURATION_SECONDS=600

# Deepest workflow → CreateEvent → workflow chain.
WORKFLOW_MAX_RECURSION_DEPTH=3

# Stuck execution recovery: threshold (minutes) and check interval (ms).
WORKFLOW_STUCK_THRESHOLD_MINUTES=15
WORKFLOW_RECOVERY_INTERVAL_MS=120000

# How often suspended delay nodes are checked for being due (ms); the resolution of a delay.
WORKFLOW_RESUME_INTERVAL_MS=5000

# Due executions resumed per tick; the rest wait for the next tick.
WORKFLOW_RESUME_BATCH_SIZE=50

# Per-node timeouts (seconds) and the timeout thread pool size.
WORKFLOW_NODE_TIMEOUT_DEFAULT_SECONDS=30
WORKFLOW_NODE_TIMEOUT_HTTP_SECONDS=60
WORKFLOW_NODE_TIMEOUT_SLACK_SECONDS=60
WORKFLOW_NODE_TIMEOUT_CREATE_EVENT_SECONDS=30
WORKFLOW_NODE_TIMEOUT_POOL_SIZE=16

# Seconds to wait for in-flight workflows on shutdown.
WORKFLOW_SHUTDOWN_AWAIT_SECONDS=30

# Workflow trigger outbox: poll interval (ms), batch size, attempts per trigger.
WORKFLOW_TRIGGER_OUTBOX_POLL_INTERVAL_MS=2000
WORKFLOW_TRIGGER_OUTBOX_BATCH_SIZE=50
WORKFLOW_TRIGGER_OUTBOX_MAX_ATTEMPTS=3
# Triggers claimed per project per batch.
WORKFLOW_TRIGGER_OUTBOX_MAX_PER_PROJECT=5
# Concurrent workflow executions per project.
WORKFLOW_TRIGGER_OUTBOX_MAX_CONCURRENT_PER_PROJECT=3
# Minutes after which a trigger abandoned in PROCESSING is requeued, and the sweep interval (ms).
# Keep it above your longest workflow, or a live one runs twice.
WORKFLOW_TRIGGER_OUTBOX_STALLED_AFTER_MINUTES=15
WORKFLOW_TRIGGER_OUTBOX_STALLED_SWEEP_MS=300000

# ----------------------------------------------------------------------------
# DEVICE AUTHORIZATION
# ----------------------------------------------------------------------------
# Expired device code cleanup interval (ms).
DEVICE_AUTH_CLEANUP_INTERVAL_MS=300000

# ----------------------------------------------------------------------------
# EMAIL VERIFICATION
# ----------------------------------------------------------------------------
# Send real email (false logs links to the console). Also enforces email verification: while
# off, new accounts are marked verified. Turn on wherever registration is open to strangers.
EMAIL_ENABLED=false

# Sender address; use a domain you own, or mail fails SPF/DKIM and lands in spam.
EMAIL_FROM=noreply@example.com

# Contact address in the notice about an unexpected email change; empty says to contact the administrator.
EMAIL_SUPPORT_ADDRESS=

# Welcome and follow-up mail to new accounts, written for Railhook Cloud; keep off when self-hosting.
ONBOARDING_EMAILS_ENABLED=false

# Contact form messages sent per UTC day, so the form cannot spend the mail quota verification needs.
CONTACT_DAILY_LIMIT=30

# SMTP relay, used when EMAIL_ENABLED=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# ----------------------------------------------------------------------------
# ALERT NOTIFICATIONS
# ----------------------------------------------------------------------------
# Send alert notifications to Slack, webhooks and email (false logs them instead).
ALERTS_NOTIFICATIONS_ENABLED=false

# Alert rule evaluation schedule (cron); how late an alert can be, not its window.
ALERTS_EVALUATION_CRON=0 * * * * *

# ----------------------------------------------------------------------------
# ENTITLEMENTS (limits when billing is off)
# ----------------------------------------------------------------------------
# Rate limit (events/s) and fan-out applied when BILLING_ENABLED=false, instead of no limit.
ENTITLEMENT_DEFAULT_RATE_LIMIT=100
ENTITLEMENT_DEFAULT_MAX_FANOUT=50

# ----------------------------------------------------------------------------
# CAPTCHA (registration)
# ----------------------------------------------------------------------------
# Registration CAPTCHA secret and verify URL (Turnstile by default; hCaptcha works too). Empty means
# no challenge; required with APP_ENV=production and BILLING_ENABLED=true. Fails closed.
# CAPTCHA_SECRET_KEY=
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
#
# Site key and script for the registration page, read by the ui container at start. Set together
# with CAPTCHA_SECRET_KEY, or every registration is refused.
# CAPTCHA_SITE_KEY=
# CAPTCHA_SCRIPT_URL=https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit

# ----------------------------------------------------------------------------
# PUBLIC WEBHOOK TESTER
# ----------------------------------------------------------------------------
# The anonymous /tester page; off by default. Live URLs per address and overall when on.
# PUBLIC_TESTER_ENABLED=false
# PUBLIC_TESTER_PER_ADDRESS=3
# PUBLIC_TESTER_MAX_ACTIVE=5000

# ----------------------------------------------------------------------------
# LIVE DEMO
# ----------------------------------------------------------------------------
# Anonymous read-only demo organization; off by default, and turning it off deletes it. Session
# length and data refresh in minutes. Set on both api and ui.
# DEMO_ENABLED=false
# DEMO_SESSION_TTL_MINUTES=30
# DEMO_REFRESH_INTERVAL_MINUTES=60

# JavaScript transformation runs per minute for a demo session and per IP. Runs hold request
# threads, so at a 2000 ms timeout 60 per IP bounds one address to two threads.
# DEMO_SCRIPT_RUNS_PER_SESSION_PER_MINUTE=20
# DEMO_SCRIPT_RUNS_PER_IP_PER_MINUTE=60

# ----------------------------------------------------------------------------
# BLOG
# ----------------------------------------------------------------------------
# Serve Railhook's own blog at /blog; off by default. Read by the ui container.
# BLOG_ENABLED=false

# ----------------------------------------------------------------------------
# WEB ANALYTICS
# ----------------------------------------------------------------------------
# Cloudflare Web Analytics token; empty loads no analytics. Read by the ui container at start.
# WEB_ANALYTICS_TOKEN=

# Status page URL linked from the footer; empty shows no link. Read by the ui container at start.
# STATUS_PAGE_URL=

# ----------------------------------------------------------------------------
# SIGN IN WITH GOOGLE
# ----------------------------------------------------------------------------
# "Continue with Google", off unless both are set. Redirect URI:
# <APP_BASE_URL>/api/v1/auth/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# BILLING / PLANS
# ----------------------------------------------------------------------------
# Enforce plan quotas (false = self-hosted, unlimited). In production it also requires
# EMAIL_ENABLED=true and CAPTCHA_SECRET_KEY.
BILLING_ENABLED=false

# noop | stripe | wayforpay; noop with billing on runs the free plan only.
BILLING_DEFAULT_PROVIDER=noop

# Stripe credentials; STRIPE_PRICE_MAP is plan_interval=price_id (interval _monthly or _yearly).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MAP=starter_monthly=price_xxx,starter_yearly=price_xxy,pro_monthly=price_yyy,pro_yearly=price_yyz

# Schedule for syncing billing state from Stripe (cron).
BILLING_RECONCILIATION_CRON=0 0 */6 * * *

# WayForPay credentials; WAYFORPAY_PLAN_PRICES is plan_interval=amount_in_cents.
# WAYFORPAY_MERCHANT_ACCOUNT=your_merchant_account
# WAYFORPAY_MERCHANT_SECRET=your_merchant_secret_key
# WAYFORPAY_MERCHANT_DOMAIN=example.com
# WAYFORPAY_SERVICE_URL=https://example.com/api/v1/billing/webhook/wayforpay
# WAYFORPAY_PLAN_PRICES=starter_monthly=2900,starter_yearly=29000,pro_monthly=9900,pro_yearly=99000

# Build-time only: locale the public pages are prerendered in.
PRERENDER_LOCALE=en

# ----------------------------------------------------------------------------
# TUNNEL (CLI local webhook tunnels)
# ----------------------------------------------------------------------------
# Public base URL of incoming-source and tunnel URLs; defaults to APP_BASE_URL.
TUNNEL_INGRESS_BASE_URL=http://localhost:8080

# Seconds without a heartbeat before a tunnel session is stale.
TUNNEL_HEARTBEAT_TIMEOUT_SECONDS=120

# Stale session cleanup interval (ms).
TUNNEL_CLEANUP_INTERVAL_MS=60000

# Tunnel request log retention (days), enforced by dropping weekly partitions.
TUNNEL_REQUEST_LOG_RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# MCP SERVER (AI agents)
# ----------------------------------------------------------------------------
# Serve the MCP server at /mcp, authenticated with a project API key.
MCP_ENABLED=true

# OAuth sign-in for MCP connectors (claude.ai, ChatGPT); needs APP_BASE_URL to be the public
# origin. false accepts API keys only.
MCP_OAUTH_ENABLED=true

# ----------------------------------------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------------------------------------
# Comma-separated allowed origins. Must include the RAILHOOK_PORT origin: browsers send Origin on
# same-origin POSTs too.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# ----------------------------------------------------------------------------
# OBSERVABILITY
# ----------------------------------------------------------------------------
# TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Serve Swagger UI; keep false in production.
SWAGGER_ENABLED=false

# ----------------------------------------------------------------------------
# JVM TUNING
# ----------------------------------------------------------------------------
# Extra JVM flags, appended to the image's container tuning; an explicit -Xmx still wins.
# API_JAVA_OPTS=-Xms256m -Xmx384m
# WORKER_JAVA_OPTS=-Xms384m -Xmx512m

# Expose Prometheus metrics.
METRICS_ENABLED=true

# ----------------------------------------------------------------------------
# RESOURCE LIMITS (Docker deploy.resources)
# ----------------------------------------------------------------------------
# Container memory limits.
# POSTGRES_MEMORY_LIMIT=1G
# KAFKA_MEMORY_LIMIT=1G
# Kafka JVM heap; keep it near half of KAFKA_MEMORY_LIMIT, the rest serves page cache and buffers.
# KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# REDIS_MEMORY_LIMIT=512m
# API_MEMORY_LIMIT=768m
# WORKER_MEMORY_LIMIT=768m

# API containers. Two make `railhook upgrade` seamless (about 600 MB more); one costs ~30s of 502
# per upgrade while the JVM starts.
API_REPLICAS=1
# UI container memory limit.
# UI_MEMORY_LIMIT=128m

# ----------------------------------------------------------------------------
# MONITORING STACK (optional)
# ----------------------------------------------------------------------------
# Grafana admin password, 16+ characters; the stack refuses to start without it. Re-applied on
# every start.
GRAFANA_ADMIN_PASSWORD=
# Grafana admin login.
GRAFANA_ADMIN_USER=admin
# Loopback port Grafana is published on.
GRAFANA_PORT=3001
# Host name to serve Grafana on through the built-in Caddy; empty keeps it loopback-only. Put an
# identity-aware proxy in front.
MONITORING_DOMAIN=
# Certificate and key Caddy serves for MONITORING_DOMAIN instead of obtaining one, as paths inside
# the Caddy container. Both or neither.
MONITORING_TLS_CERT=
MONITORING_TLS_KEY=
# Comma-separated URLs for the uptime probes; empty probes RAILHOOK_DOMAIN when set.
MONITORING_PROBE_URLS=
# Platform Docker network to join; empty finds it by its Compose label.
RAILHOOK_NETWORK=
# Server name shown on the Host dashboard; empty uses the hostname.
MONITORING_NODENAME=
# Backup directory, relative to monitoring/, read by the BackupStale alert.
MONITORING_BACKUP_DIR=../backups
# Prometheus retention time and disk budget.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=4GB

# ----------------------------------------------------------------------------
# ALERTING (optional)
# ----------------------------------------------------------------------------
# Alertmanager receivers. With none set, alerts show only in Grafana.
#
# Slack incoming webhook URL and channel.
ALERTMANAGER_SLACK_WEBHOOK_URL=
ALERTMANAGER_SLACK_CHANNEL=#railhook-alerts
# Generic webhook receiver URL (PagerDuty Events v2, Opsgenie, …).
ALERTMANAGER_WEBHOOK_URL=
# Alert email recipient; sender and relay default to EMAIL_FROM and SMTP_*.
ALERTMANAGER_EMAIL_TO=
ALERTMANAGER_EMAIL_FROM=
ALERTMANAGER_SMTP_HOST=
ALERTMANAGER_SMTP_PORT=
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
# true | false; empty requires TLS except for localhost, mailpit and mailhog.
ALERTMANAGER_SMTP_REQUIRE_TLS=
# Telegram bot token and chat id (negative for groups); both, or Telegram stays off.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
# Heartbeat URL pinged every minute by the Watchdog alert, so an outside service notices this
# host going down.
ALERTMANAGER_HEARTBEAT_URL=
# Alertmanager's address in Slack and webhook payloads.
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# ----------------------------------------------------------------------------
# LOG AGGREGATION (Loki)
# ----------------------------------------------------------------------------
# How long Loki keeps log lines (Go duration, e.g. 168h).
LOKI_RETENTION_PERIOD=168h

# ----------------------------------------------------------------------------
# BACKUP CONFIGURATION
# ----------------------------------------------------------------------------
# Backup directory and retention (days) for `make backup-db` and the db-backup service.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Seconds between scheduled backups by the db-backup service.
DB_BACKUP_INTERVAL_SECONDS=86400

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
#   1. Set APP_ENV=production
#   2. Change WEBHOOK_ENCRYPTION_KEY, WEBHOOK_ENCRYPTION_SALT, JWT_SECRET, POSTGRES_PASSWORD,
#      REDIS_PASSWORD
#   3. Set DB_SSL_MODE=require (or verify-full)
#   4. Set RAILHOOK_BIND=127.0.0.1 behind a reverse proxy
#   5. Set EMAIL_ENABLED=true and configure SMTP
#   6. Set CORS_ALLOWED_ORIGINS to your domain
