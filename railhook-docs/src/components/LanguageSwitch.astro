---
/**
 * Replaces Starlight's language <select>: "EN | UK" as two links to the same page, as in the
 * dashboard header. Every English page has a Ukrainian twin at the same path under /uk/ — the
 * parity test holds that — so the other language's address is a prefix swap.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isUk = Astro.locals.starlightRoute.locale === 'uk';
const path = Astro.url.pathname;
const enHref = isUk ? path.replace(`${base}/uk/`, `${base}/`) : path;
const ukHref = isUk ? path : path.replace(`${base}/`, `${base}/uk/`);
const options = [
  { code: 'EN', lang: 'en', href: enHref, current: !isUk, name: 'English' },
  { code: 'UK', lang: 'uk', href: ukHref, current: isUk, name: 'Українська' },
];
---

<nav class="switch" aria-label={Astro.locals.t('languageSelect.accessibleLabel')}>
  {
    options.map((o) => (
      <a href={o.href} hreflang={o.lang} lang={o.lang} aria-current={o.current ? 'page' : undefined} title={o.name}>
        {o.code}
      </a>
    ))
  }
</nav>

<style>
  .switch {
    display: inline-flex;
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  a {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    padding: 0 0.625rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  a[aria-current='page'] {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-white);
    outline-offset: 1px;
  }
</style>
